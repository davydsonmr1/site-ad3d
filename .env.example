# Required in production. Used to HMAC-sign protected asset URLs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ASSET_SIGNING_SECRET=

# Comma-separated hosts allowed to embed protected assets (anti-hotlink).
# Your own host is always allowed automatically.
# ALLOWED_ASSET_HOSTS=ad3d.lab,www.ad3d.lab

# Burn a watermark into served images (true/false) and its text.
ASSET_WATERMARK_ENABLED=false
ASSET_WATERMARK_TEXT=AD3D.LAB

# --- Admin panel (/admin) ---
ADMIN_USERNAME=admin
# Generate: node scripts/hash-password.mjs "sua-senha-forte"
ADMIN_PASSWORD_HASH=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# --- Supabase (banco + storage) ---
# Quando definidos, o app usa Supabase; senão, cai no armazenamento local (dev).
SUPABASE_URL=
# Chave SECRETA / service_role (Dashboard → Settings → API). NUNCA exponha no client.
SUPABASE_SERVICE_ROLE_KEY=
# Nome do bucket privado (padrão: assets)
SUPABASE_BUCKET=assets
